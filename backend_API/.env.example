# Conexión MySQL local del proyecto. Cada integrante debe usar su contraseña.
DB_USER=root
DB_PASSWORD=pon-aqui-tu-contrasena-de-mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=bd_aplicacion_movil
# Alternativamente, configura una DATABASE_URL completa.
# DATABASE_URL=mysql+pymysql://root:TU_CONTRASENA@127.0.0.1:3306/bd_aplicacion_movil?charset=utf8mb4

# Clave para firmar los tokens JWT. Genera una con:
#   python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=pon-aqui-una-clave-larga-y-aleatoria
JWT_HORAS=8

# SMTP para enviar enlaces de recuperación (por ejemplo, puerto 587 con STARTTLS).
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_STARTTLS=true

# URL pública de Flutter Web que abre el formulario de restablecimiento.
PASSWORD_RESET_URL=http://localhost:51930/#/reset-password

# Clave independiente para proteger los tokens guardados en la base de datos.
# Genera una con: python -c "import secrets; print(secrets.token_hex(32))"
PASSWORD_RESET_SECRET=pon-aqui-otra-clave-larga-y-aleatoria
